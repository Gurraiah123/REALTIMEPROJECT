pipeline {
    agent any
 
    environment {
        DOCKERHUB_USER = 'guru0114'                 // must match the image name prefix
        IMAGE_NAME     = 'guru0114/k8s'
        SONAR_URL      = 'http://localhost:9000'    // SonarQube runs on the Jenkins server
        GIT_REPO_NAME  = 'REALTIMEPROJECT'
        GIT_USER_NAME  = 'Gurraiah123'
    }
 
    stages {
 
        stage('Checkout Code') {
            steps {
                echo 'Checking out source code'
                git branch: 'main', url: 'https://github.com/Gurraiah123/REALTIMEPROJECT.git'
            }
        }
 
        stage('Build Jar') {
            steps {
                echo 'Running Maven build'
                sh 'cd Application && mvn clean package'
            }
        }
 
        stage('Sonar Scan') {
            steps {
                echo 'Running SonarQube scan'
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    // No "clean verify" here: the jar and tests were already built above
                    sh '''
                        cd Application
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar \
                          -Dsonar.host.url=${SONAR_URL} \
                          -Dsonar.token=${SONAR_TOKEN}
                    '''
                }
            }
        }
 
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker Image'
                sh 'cd Application && docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -f Dockerfile .'
            }
        }
 
        stage('Docker Image Scan') {
            steps {
                echo 'Scanning Docker image using Trivy'
                // --exit-code 0 reports findings without failing the build.
                // Change to --exit-code 1 to fail on HIGH/CRITICAL vulnerabilities.
                sh '''
                    trivy image --no-progress --timeout 20m --scanners vuln \
                      --severity HIGH,CRITICAL --exit-code 0 \
                      ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }
 
        stage('Push Image to DockerHub') {
            steps {
                withCredentials([string(credentialsId: 'dockerhub', variable: 'DOCKERHUB_TOKEN')]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" | docker login -u ${DOCKERHUB_USER} --password-stdin
                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }
 
        stage('Update Kubernetes Deployment Manifest File') {
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "guru167677@gmail.com"
                        git config user.name "${GIT_USER_NAME}"
 
                        # Only replace this image's tag, not every "k8s:" in the file
                        sed -i "s|${IMAGE_NAME}:.*|${IMAGE_NAME}:${BUILD_NUMBER}|g" Ansible/k8s_deployment.yaml
 
                        git add Ansible/k8s_deployment.yaml
 
                        if ! git diff --cached --quiet; then
                            git commit -m "Update deployment image tag to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                        else
                            echo "No deployment manifest changes to commit"
                        fi
                    '''
                }
            }
        }
 
        stage('K8s Deployment using Ansible') {
            steps {
                ansiblePlaybook(
                    credentialsId: 'ssh',
                    disableHostKeyChecking: true,
                    installation: 'ansible',
                    inventory: '/etc/ansible/inventory',
                    playbook: 'Ansible/ansible_k8s_deploy_playbook.yaml'
                )
            }
        }
    }
 
    post {
        always {
            sh 'docker logout || true'
            sh 'docker rmi ${IMAGE_NAME}:${BUILD_NUMBER} || true'
        }
    }
}
