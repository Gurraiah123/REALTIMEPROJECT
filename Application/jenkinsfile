
pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Checking out source code'
                git branch: 'main', url: 'https://github.com/Gurraiah123/REALTIMEPROJECT.git'
            }
        }

        stage('Build Jar') {
            steps {
                echo 'Running Maven build'
                sh 'cd Application && mvn clean package'
            }
        }

        stage('Sonar Scan') {
            steps {
                echo 'Running SonarQube scan'

                withCredentials([string(
                    credentialsId: 'sonar-token',
                    variable: 'SONAR_TOKEN'
                )]) {
                    sh '''
                        cd Application

                        mvn clean verify \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:5.0.0.4389:sonar \
                          -Dsonar.host.url=http://18.215.188.231:9000 \
                          -Dsonar.token=$SONAR_TOKEN
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo 'Building Docker Image'
                    sh 'cd Application && docker build -t guru0114/k8s:${BUILD_NUMBER} -f Dockerfile .'
                }
            }
        }

        stage('Docker Image Scan') {
            steps {
                sh 'trivy image guru0114/k8s:${BUILD_NUMBER}'
            }
        }

        stage('Push Image to DockerHub') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'dockerhub', variable: 'dockerhub')]) {
                        sh 'echo "$dockerhub" | docker login -u devopshubg333 --password-stdin'
                    }

                    sh 'docker push guru0114/k8s:${BUILD_NUMBER}'
                }
            }
        }

        stage('Update Kubernetes Deployment Manifest File') {
            environment {
                GIT_REPO_NAME = "REALTIMEPROJECT"
                GIT_USER_NAME = "Gurraiah123"
            }

            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "guru167677@gmail.com"
                        git config user.name "Gurraiah123"

                        sed -i "s|k8s:.*|k8s:${BUILD_NUMBER}|g" Ansible/k8s_deployment.yaml

                        git add Ansible/k8s_deployment.yaml

                        if ! git diff --cached --quiet; then
                            git commit -m "Update deployment image tag to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        else
                            echo "No deployment manifest changes to commit"
                        fi
                    '''
                }
            }
        }

        stage('K8s Deployment using Ansible') {
            steps {
                script {
                    ansiblePlaybook(
                        credentialsId: 'ssh',
                        disableHostKeyChecking: true,
                        installation: 'ansible',
                        inventory: '/etc/ansible/inventory',
                        playbook: 'Ansible/ansible_k8s_deploy_playbook.yaml'
                    )
                }
            }
        }
    }
}
